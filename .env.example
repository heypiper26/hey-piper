# ─── Banco de dados (obrigatório) ────────────────────────────────────────────
# Supabase > seu projeto > botão "Connect" > aba "Connection String" > "Transaction pooler"
# (porta 6543), com [YOUR-PASSWORD] trocado pela senha do banco. Formato:
# postgresql://postgres.<project-ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ─── Acesso ao app (obrigatório) ─────────────────────────────────────────────
# Senha inicial de login (sugestão: heypiper). Depois do primeiro acesso, troque em Configurações — a
# nova senha fica salva (com hash) no banco e esta variável deixa de valer.
APP_PASSWORD=

# Chave que assina o cookie de sessão. String aleatória longa, NUNCA a senha acima.
# Gere com: openssl rand -hex 32
SESSION_SECRET=

# ─── IA (obrigatório para File Import e Relatório do Mês) ───────────────────
# https://console.anthropic.com > API Keys (começa com sk-ant-)
ANTHROPIC_API_KEY=

# Modelo de cada recurso. `claude-*` usa a Anthropic; qualquer outro (gpt-*, o3...)
# usa a OpenAI e exige OPENAI_API_KEY. Vazio = padrão claude-sonnet-5-5.
MODEL_SMART_IMPORT=
MODEL_MONTHLY_REPORT=

# Opcional — só se algum MODEL_* acima for um modelo da OpenAI.
OPENAI_API_KEY=

# ─── Pluggy / Open Finance (opcional — sincronização bancária e Patrimônio) ──
# https://dashboard.pluggy.ai > Applications > sua aplicação
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Id da conexão (item) com o seu banco, via Meu Pluggy — ver README, passo 5.3.
PLUGGY_ITEM_ID=

# ─── Cron diário do Patrimônio (obrigatório se usar Pluggy) ──────────────────
# A Vercel envia "Authorization: Bearer <CRON_SECRET>" ao chamar /api/patrimonio/cron.
# Gere com: openssl rand -hex 32
CRON_SECRET=
